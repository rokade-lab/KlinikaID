{
    "name": "klinikaid/klinikaid",
    "description": "KlinikaID — aplikasi klinik dummy untuk lab secure coding (Patient Data Exposure across Role Boundaries)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4 <8.5",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "KlinikaID\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KlinikaID\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
